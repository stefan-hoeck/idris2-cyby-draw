package cyby-css

authors = "Stefan Höck"
brief   = "An opinionated CSS framework written in Idris"

version = 0.1.0
sourcedir = "src"
depends = base        >= 0.7.0
        , async-dom-extra
        , chem

modules = CyBy.UI.CSS.Classes
        , CyBy.UI.CSS.Rules
        , CyBy.UI.CSS.Vars
        , CyBy.UI.HTML
